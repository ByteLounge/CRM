# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Supabase PostgreSQL / Direct PostgreSQL)
# If DATABASE_URL is not set, FlowCRM automatically runs with embedded SQLite for seamless offline testing
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & JWT
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# WooCommerce Integration (Live Mode)
# Leave empty or set WOOCOMMERCE_MOCK_MODE=true to enable DEMO MODE with simulated store data
WOOCOMMERCE_MOCK_MODE=true
WOOCOMMERCE_STORE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret_here

# AI Configuration (Gemini API or compatible LLM)
# If GEMINI_API_KEY is not provided, FlowAI uses structured analytical heuristic fallback
GEMINI_API_KEY=
